# CI、Android Release 和 iOS Device Archive 的工具链版本。
# 各 workflow 在安装工具前执行 `grep -E '^[A-Za-z_][A-Za-z0-9_]*=' .github/toolchain.env >> "$GITHUB_ENV"` 载入（注释与空行被过滤）。
# 注意：必须使用 KEY=VALUE 纯文本行（无引号、无 export），GITHUB_ENV 才能正确解析。
# Rust 工具链不在此列——由仓库根 rust-toolchain.toml 承担。
NODE_VERSION=24.14.1
PNPM_VERSION=12.6.0
JAVA_VERSION=17.0.20+8
ANDROID_COMPILE_SDK_VERSION=36
ANDROID_BUILD_TOOLS_VERSION=36.0.0
NDK_VERSION=29.0.14206865
IOS_XCODE_VERSION=26.2
IOS_XCODEGEN_VERSION=2.44.1
IOS_XCODEGEN_SHA256=a2e905fb68446e9bb4008cdfe2e13e3f176d0cbcca828b71770f8e53fca91b73
