{
  "name": "vcp-mobile",
  "private": true,
  "version": "1.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "android:debug": "node tests/e2e-android/scripts/android-debug-agent.cjs",
    "android:debug:doctor": "node tests/e2e-android/scripts/android-debug-agent.cjs doctor",
    "android:debug:dev": "node tests/e2e-android/scripts/android-debug-agent.cjs dev",
    "android:debug:status": "node tests/e2e-android/scripts/android-debug-agent.cjs status",
    "android:debug:logs": "node tests/e2e-android/scripts/android-debug-agent.cjs logs",
    "android:debug:snapshot": "node tests/e2e-android/scripts/android-debug-agent.cjs snapshot",
    "android:debug:screenshot": "node tests/e2e-android/scripts/android-debug-agent.cjs screenshot",
    "android:debug:reload": "node tests/e2e-android/scripts/android-debug-agent.cjs reload",
    "android:debug:stop": "node tests/e2e-android/scripts/android-debug-agent.cjs stop",
    "android:debug:install": "node tests/e2e-android/scripts/android-debug-agent.cjs install",
    "android:debug:grant": "node tests/e2e-android/scripts/android-debug-agent.cjs grant",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "node tools/check.mjs",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
    "config:generate": "cargo run --locked --manifest-path src-tauri/Cargo.toml -p vcp-config-export --",
    "config:check": "cargo run --locked --manifest-path src-tauri/Cargo.toml -p vcp-config-export -- --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "cargo test --locked --manifest-path src-tauri/Cargo.toml --test file_extractor_integration",
    "ci:prepare-android-settings": "node .github/generate-tauri-android-settings.mjs",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock",
    "test:coverage": "vitest run --coverage",
    "perf:apk-size": "node tests/perf/scripts/measure_apk_size.cjs",
    "perf:startup": "node tests/perf/scripts/measure_startup_adb.cjs",
    "perf:collect:full": "node tests/perf/scripts/collect_android_dumpsys.cjs",
    "perf:sync-pipeline": "node tests/perf/scripts/measure_sync_pipeline.cjs",
    "perf:rust-bench": "node tests/perf/scripts/run_rust_bench.cjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-os": "2.4.0",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "katex": "^0.18.10",
    "marked": "^18.1.1",
    "morphdom": "^2.7.8",
    "pele": "1.9.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sortablejs": "^1.15.7",
    "tauri-plugin-vcp-mobile": "file:src-tauri/plugins/vcp-mobile",
    "vue": "^3.5.44",
    "vue-cropper": "^1.1.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@pinia/testing": "^2.0.2",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.19.2",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@unocss/preset-attributify": "^66.11.0",
    "@unocss/preset-typography": "^66.11.0",
    "@unocss/preset-wind3": "^66.11.0",
    "@unocss/reset": "^66.11.0",
    "@unocss/transformer-directives": "^66.11.0",
    "@unocss/transformer-variant-group": "^66.11.0",
    "@unocss/vite": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
