<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.vcp_mobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
    </style>

    <!-- Android 12+ always owns the first launch frame. Keep it visually continuous
         with index.html instead of exposing the masked launcher application icon. -->
    <style name="Theme.vcp_mobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F4F6F8</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.vcp_mobile</item>
    </style>
</resources>
