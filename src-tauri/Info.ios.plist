<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>VCPShareAppGroup</key>
  <string>group.com.vcp.avatar</string>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.vcp.avatar.configuration</string>
      <key>UTTypeDescription</key>
      <string>VCPMobile 配置备份</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.json</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>vcpcfg</string></array>
        <key>public.mime-type</key>
        <string>application/vnd.vcp.config+json</string>
      </dict>
    </dict>
  </array>
  <key>UIBackgroundModes</key>
  <array><string>audio</string></array>
  <key>NSLocalNetworkUsageDescription</key>
  <string>连接您配置的局域网 VCP 服务，进行聊天、数据同步和设备工具协作。</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <key>NSMotionUsageDescription</key>
  <string>在您启用设备传感器工具时，读取运动和气压数据并返回给您连接的 VCP 服务。</string>
  <key>NSCameraUsageDescription</key>
  <string>在您点击拍照时拍摄照片，并作为聊天附件添加。</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>在您进入语音通话并开启麦克风时采集声音，用于在设备上检测语音活动、处理回声并显示实时音波。</string>
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>在您点击保存图片时，将所选图片或图表写入照片图库。</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>在您启用定位工具并发起采样时，获取设备位置并返回给您连接的 VCP 服务。</string>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key>
          <string>TaoScene</string>
          <key>UISceneClassName</key>
          <string>UIWindowScene</string>
          <key>UISceneDelegateClassName</key>
          <string>TaoSceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
</dict>
</plist>
